# =============================================================================
# Google ADK Multi-Agent System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Google AI / Vertex AI Configuration
# -----------------------------------------------------------------------------
# Set to "true" to use Vertex AI, "false" for Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=false

# Google AI Studio API Key (when GOOGLE_GENAI_USE_VERTEXAI=false)
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Vertex AI Configuration (when GOOGLE_GENAI_USE_VERTEXAI=true)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Service Account (optional, for explicit auth)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
DEFAULT_MODEL=gemini-2.5-flash
THINKING_MODEL=gemini-2.5-pro

# -----------------------------------------------------------------------------
# OAuth2 Configuration (for Google API Toolsets)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# -----------------------------------------------------------------------------
# Vertex AI Search Configuration
# -----------------------------------------------------------------------------
VERTEX_AI_SEARCH_DATA_STORE_ID=projects/your-project/locations/global/collections/default_collection/dataStores/your-datastore
VERTEX_AI_SEARCH_ENGINE_ID=projects/your-project/locations/global/collections/default_collection/engines/your-engine

# -----------------------------------------------------------------------------
# BigQuery Configuration
# -----------------------------------------------------------------------------
BIGQUERY_PROJECT=your-bigquery-project
BIGQUERY_DATASET=your-dataset

# -----------------------------------------------------------------------------
# API Hub Configuration
# -----------------------------------------------------------------------------
APIHUB_RESOURCE_NAME=projects/your-project/locations/us-central1/apis/your-api

# -----------------------------------------------------------------------------
# Application Integration Configuration
# -----------------------------------------------------------------------------
APP_INTEGRATION_PROJECT=your-project
APP_INTEGRATION_LOCATION=us-central1
APP_INTEGRATION_NAME=your-integration

# -----------------------------------------------------------------------------
# MCP Server Configuration (Generic)
# -----------------------------------------------------------------------------
# Stdio MCP Server (local)
MCP_STDIO_COMMAND=npx
MCP_STDIO_ARGS=-y,@modelcontextprotocol/server-filesystem

# SSE MCP Server (remote)
MCP_SSE_URL=http://localhost:8080/sse

# Streamable HTTP MCP Server
MCP_HTTP_URL=http://localhost:8080/mcp

# -----------------------------------------------------------------------------
# MCP Integrations - Code & DevOps
# -----------------------------------------------------------------------------
# GitHub MCP
GITHUB_TOKEN=your-github-personal-access-token

# GitLab MCP
GITLAB_TOKEN=your-gitlab-token
GITLAB_BASE_URL=https://gitlab.com

# Daytona MCP
DAYTONA_API_KEY=your-daytona-api-key

# -----------------------------------------------------------------------------
# MCP Integrations - AI & ML
# -----------------------------------------------------------------------------
# Hugging Face MCP
HF_TOKEN=your-huggingface-access-token

# ElevenLabs MCP (Audio/Voice)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# -----------------------------------------------------------------------------
# MCP Integrations - Productivity
# -----------------------------------------------------------------------------
# Notion MCP
NOTION_TOKEN=your-notion-integration-token

# Linear MCP
LINEAR_API_KEY=your-linear-api-key

# Atlassian MCP (Jira/Confluence)
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net

# Asana MCP
ASANA_ACCESS_TOKEN=your-asana-access-token

# -----------------------------------------------------------------------------
# MCP Integrations - Business & Payments
# -----------------------------------------------------------------------------
# Stripe MCP
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# PayPal MCP
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# -----------------------------------------------------------------------------
# MCP Integrations - API & Automation
# -----------------------------------------------------------------------------
# Postman MCP
POSTMAN_API_KEY=your-postman-api-key

# N8N MCP
N8N_API_KEY=your-n8n-api-key
N8N_BASE_URL=http://localhost:5678

# -----------------------------------------------------------------------------
# Toolbox Configuration (MCP Toolbox for Databases)
# -----------------------------------------------------------------------------
TOOLBOX_SERVER_URL=http://127.0.0.1:5000

# -----------------------------------------------------------------------------
# Observability Platforms
# -----------------------------------------------------------------------------
# AgentOps
AGENTOPS_API_KEY=your-agentops-api-key

# Arize AX
ARIZE_API_KEY=your-arize-api-key
ARIZE_SPACE_ID=your-arize-space-id

# Phoenix
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_ID=123

# Monocle (no API key required, uses file export)
MONOCLE_EXPORTER=file

# W&B Weave
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT_ID=entity/project

# Freeplay
FREEPLAY_API_KEY=your-freeplay-api-key

# -----------------------------------------------------------------------------
# Memory Service Configuration
# -----------------------------------------------------------------------------
# Vertex AI Memory Bank
MEMORY_BANK_AGENT_ENGINE_ID=your-agent-engine-id

# Vertex AI RAG
RAG_CORPUS_NAME=projects/your-project/locations/us-central1/ragCorpora/your-corpus

# -----------------------------------------------------------------------------
# Artifact Storage Configuration
# -----------------------------------------------------------------------------
# For GCS Artifact Service
GCS_ARTIFACT_BUCKET=your-artifact-bucket

# For File Artifact Service
FILE_ARTIFACT_ROOT=/tmp/adk_artifacts

# -----------------------------------------------------------------------------
# Session Service Configuration
# -----------------------------------------------------------------------------
# Vertex AI Session Service
SESSION_AGENT_ENGINE_ID=your-session-agent-engine-id

# -----------------------------------------------------------------------------
# Debug Configuration
# -----------------------------------------------------------------------------
DEBUG_OUTPUT_PATH=adk_debug.yaml
ENABLE_DEBUG_LOGGING=false

# -----------------------------------------------------------------------------
# Runtime Configuration
# -----------------------------------------------------------------------------
MAX_LLM_CALLS=500
STREAMING_MODE=NONE
